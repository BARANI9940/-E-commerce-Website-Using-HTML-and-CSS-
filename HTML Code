<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopEasy - E-Commerce</title>
    <link rel="stylesheet" href="ecommerce.css">
</head>

<body>

    
    <header>
        <div class="logo">ShopEasy</div>

        <nav>
            <a href="#">Home</a>
            <a href="#products">Products</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>

        <div class="cart">
            🛒 Cart
        </div>
    </header>

    <section class="hero">
        <div class="hero-content">
            <h1>Welcome to ShopEasy</h1>
            <p>Find the best products at affordable prices.</p>
            <button>Shop Now</button>
        </div>
    </section>

    
    <section id="products" class="products-section">

        <h2>Our Products</h2>

        <div class="products">

            <div class="product-card">
                <img src="wirelessheadphone.jpg" alt="Headphones">

                <h3>Wireless Headphones</h3>

                <p>High-quality wireless headphones.</p>

                <h4>₹1,499</h4>

                <button>Add to Cart</button>
            </div>


            <div class="product-card">
                <img src="smartwatch.jpg" alt="Smart Watch">

                <h3>Smart Watch</h3>

                <p>Stylish smartwatch with multiple features.</p>

                <h4>₹2,499</h4>

                <button>Add to Cart</button>
            </div>


            <div class="product-card">
                <img src="shoes.jpg" alt="Shoes">

                <h3>Running Shoes</h3>

                <p>Comfortable shoes for everyday use.</p>

                <h4>₹1,999</h4>

                <button>Add to Cart</button>
            </div>


            <div class="product-card">
                <img src="bag.jpg" alt="Backpack">

                <h3>Travel Backpack</h3>

                <p>Durable backpack for travel and college.</p>

                <h4>₹999</h4>

                <button>Add to Cart</button>
            </div>

        </div>

    </section>


  
    <section id="about" class="about">

        <h2>About Us</h2>

        <p>
            ShopEasy is a basic e-commerce website designed to provide
            customers with a simple and user-friendly shopping experience.
        </p>

    </section>


    
    <section id="contact" class="contact">

        <h2>Contact Us</h2>

        <p>Email: barani@shopeasy.com</p>
        <p>Phone: +91 12345 67890</p>

    </section>


  
    <footer>

        <p>© 2026 ShopEasy. All Rights Reserved.</p>

    </footer>

</body>
</html>
