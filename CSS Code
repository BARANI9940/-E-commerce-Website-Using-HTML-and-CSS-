* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
    color: #333;
}




header {
    height: 70px;
    background-color: #222;
    color: white;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 50px;
}

.logo {
    font-size: 28px;
    font-weight: bold;
}

nav {
    display: flex;
    gap: 30px;
}

nav a {
    color: white;
    text-decoration: none;
    font-size: 16px;
}

nav a:hover {
    color: #ff9800;
}

.cart {
    font-size: 16px;
}

.hero-content h1 {
    font-size: 45px;
    margin-bottom: 15px;
}

.hero-content p {
    font-size: 20px;
    margin-bottom: 25px;
}

button {
    background-color: #ff9800;
    color: white;

    border: none;
    padding: 12px 25px;

    border-radius: 5px;
    cursor: pointer;

    font-size: 16px;
}

button:hover {
    background-color: #e68900;
}




.products-section {
    padding: 50px;
    text-align: center;
}

.products-section h2 {
    font-size: 32px;
    margin-bottom: 35px;
}

.products {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 25px;

    max-width: 1200px;
    margin: auto;
}




.product-card {
    background-color: white;

    padding: 20px;

    border-radius: 10px;

    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);

    transition: 0.3s;
}

.product-card:hover {
    transform: translateY(-5px);
}

.product-card img {
    width: 100%;
    height: 180px;

    object-fit: cover;

    border-radius: 8px;
}

.product-card h3 {
    margin: 15px 0 10px;
}

.product-card p {
    color: #666;
    margin-bottom: 10px;
}

.product-card h4 {
    color: #e67e22;
    font-size: 20px;
    margin-bottom: 15px;
}




.about {
    background-color: white;

    text-align: center;

    padding: 50px;
}

.about h2 {
    margin-bottom: 20px;
}

.about p {
    max-width: 700px;
    margin: auto;
    line-height: 1.6;
}



.contact {
    text-align: center;

    padding: 50px;

    background-color: #eee;
}

.contact h2 {
    margin-bottom: 20px;
}

.contact p {
    margin: 8px;
}




footer {
    background-color: #222;
    color: white;

    text-align: center;

    padding: 20px;
}



@media (max-width: 900px) {

    .products {
        grid-template-columns: repeat(2, 1fr);
    }

    header {
        padding: 0 20px;
    }

}


@media (max-width: 600px) {

    header {
        height: auto;

        padding: 20px;

        flex-direction: column;

        gap: 15px;
    }

    nav {
        gap: 15px;
    }

    .hero-content h1 {
        font-size: 32px;
    }

    .products-section {
        padding: 30px 15px;
    }

    .products {
        grid-template-columns: 1fr;
    }

}
.hero {
    height: 400px;

    background:
        linear-gradient(
            rgba(0, 0, 0, 0.5),
            rgba(0, 0, 0, 0.5)
        ),
        url("banner.jpg");

    background-size: cover;
    background-position: center;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;
    color: white;
}
